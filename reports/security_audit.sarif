          ],
          "properties": {
            "poc_argv": [
              "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
            ],
            "asan_summary": "stack-buffer-overflow benchmarks/cve_sim_off_by_one.c:24 in copy_label",
            "exploit_confirmed": true
