              }
            }
          ],
          "properties": {
            "poc_argv": [
              "%p %p %p %p %n %s %s"
            ],
            "asan_summary": "SEGV ../../../../src/libsanitizer/asan/asan_interceptors_memintrinsics.h:37 in QuickCheckForUnpoisonedRegion",
            "exploit_confirmed": true
          }
        },
        {
          "ruleId": "CWE-190",
          "level": "error",
          "message": {
            "text": "Integer Overflow to Buffer Overflow in cve_sim_integer_overflow: A multiplication feeding an allocation size (count * element_size) can wrap a fixed-width integer, producing an undersized allocation that a subsequent write-loop then overflows. Dynamic verdict: CRASHED (heap-buffer-overflow) (exploit_confirmed=True)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "benchmarks/cve_sim_integer_overflow.c"
                },
                "region": {
                  "startLine": 20
                }
