              }
            }
          ],
          "properties": {
            "poc_argv": [
              "localhost; echo POC-MARKER-80f023c9 #"
            ],
            "asan_summary": null,
            "exploit_confirmed": true
          }
        },
        {
          "ruleId": "CWE-193",
          "level": "error",
          "message": {
            "text": "Off-by-One Error in cve_sim_off_by_one: A copy loop uses an inclusive bound (`i <= len`) against a fixed-size buffer, writing one byte past its end on inputs whose length equals the buffer's capacity. Dynamic verdict: CRASHED (stack-buffer-overflow) (exploit_confirmed=True)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "benchmarks/cve_sim_off_by_one.c"
                },
                "region": {
                  "startLine": 17
