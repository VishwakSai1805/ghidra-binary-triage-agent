            "asan_summary": "heap-use-after-free benchmarks/cve_sim_heap_uaf.c:39 in print_task",
            "exploit_confirmed": true
          }
        },
        {
          "ruleId": "CWE-134",
          "level": "error",
          "message": {
            "text": "Uncontrolled Format String in cve_sim_format_string: Attacker-controlled data is passed as the *format* argument to a printf-family function, letting %n/%s/%x specifiers read or write arbitrary stack memory. Dynamic verdict: CRASHED (SEGV) (exploit_confirmed=True)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "benchmarks/cve_sim_format_string.c"
