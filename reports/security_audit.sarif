            "asan_summary": "heap-buffer-overflow benchmarks/cve_sim_integer_overflow.c:37 in main",
            "exploit_confirmed": true
          }
        },
        {
          "ruleId": "CWE-78",
          "level": "error",
          "message": {
            "text": "OS Command Injection in cve_sim_command_injection: Untrusted input is concatenated into a shell command string passed to system()/popen(), letting shell metacharacters (`;`, `|`, `` ` ``, `$()`) inject arbitrary additional commands. Dynamic verdict: NO_CRASH (exploit_confirmed=True)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "benchmarks/cve_sim_command_injection.c"
                },
                "region": {
                  "startLine": 22
